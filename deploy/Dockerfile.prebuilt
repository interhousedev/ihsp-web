# Local-stack variant of deploy/Dockerfile: the static apps are built on the host, not in Docker.
#
# `next build` for seven apps needs more memory than the 8 GB Docker VM of a laptop has, so
# the iht-backend repo scripts/local_up.sh builds the apps one at a time on the host and packs the result:
#
#   cd web && bun install --frozen-lockfile
#   for app in id sp staff admin lms share library landing; do bun run --filter "./apps/$app" build; done
#   bun deploy/csp-hash.ts               # per-page script-src <meta> (same step as deploy/Dockerfile)
#   docker build -f deploy/Dockerfile.prebuilt -t ihsp-web:local .
#
# NEXT_PUBLIC_APP_VERSION (the version the installable app compares with GET /v1/app/version) is
# whatever the host build used: export it before the `bun run --filter` step, as deploy/Dockerfile's
# build arg of the same name does (1.0.0 there).
#
# Build context is web/ (see Dockerfile.prebuilt.dockerignore). The nginx stage below must stay
# identical to the one in deploy/Dockerfile (deploy/docker.test.ts checks it); only the way the
# apps get into /srv differs.

# nginx stage: the unprivileged nginx image (runs as uid 101, listens on 8080). Identical to the nginx
# stage of deploy/Dockerfile.
FROM nginxinc/nginx-unprivileged:1.31.6-alpine

# Build steps run as root; the container runs as the nginx user (see USER below) and everything it
# ships stays root-owned and read-only for it
USER root

# envsubst (from gettext) is part of the base image; fail the build here, not at container start, if not
RUN command -v envsubst >/dev/null

# nginx config: nginx.conf as is; sites and snippets are templates that entrypoint.sh renders
# with envsubst into /tmp/ihsp/nginx at every start
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/sites/ /app/templates/sites/
COPY deploy/snippets/ /app/templates/snippets/
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy built apps (from the host)
COPY apps/id/out /srv/id
COPY apps/sp/out /srv/sp
COPY apps/staff/out /srv/staff
COPY apps/admin/out /srv/admin
COPY apps/lms/out /srv/lms
COPY apps/library/out /srv/library
COPY apps/landing/out /srv/landing
COPY apps/share/out /srv/share/ai

# Copy env.js template and entrypoint
COPY deploy/env.js.template /app/env.js.template
COPY deploy/entrypoint.sh /app/entrypoint.sh

# The exports must carry the per-page script-src policy: `bun deploy/csp-hash.ts` was not run otherwise
RUN chmod +x /app/entrypoint.sh \
    && grep -rlq 'http-equiv="Content-Security-Policy"' /srv/sp \
    || { echo "apps/*/out has no CSP <meta>: run 'bun deploy/csp-hash.ts' in web/ before building" >&2; exit 1; }

# LISTEN_PORT (default 8080) is the only port; TLS is terminated by the edge nginx in front of this image
EXPOSE 8080

# busybox wget is in the base image; curl is not installed
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${LISTEN_PORT:-8080}/health"

STOPSIGNAL SIGQUIT
USER 101

ENTRYPOINT ["/app/entrypoint.sh"]
