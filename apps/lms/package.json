{
  "name": "@ihsp/lms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run copy:h5p && bun run copy:code && next dev -p 3005",
    "build": "bun run build:brand && bun run copy:h5p && bun run copy:code && bun run build:sw && next build",
    "build:brand": "bun ../../packages/config/scripts/generate-brand-assets.ts",
    "copy:h5p": "bun scripts/copy-h5p.mjs",
    "copy:code": "bun scripts/copy-code-runtimes.mjs",
    "build:sw": "bun build ../../packages/features-core/src/pwa/sw/generic.ts --outfile public/sw.js --target browser --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 --preload ../../packages/test-utils/src/preload.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/nunito": "5.3.0",
    "@ihsp/api": "workspace:*",
    "@ihsp/auth": "workspace:*",
    "@ihsp/config": "workspace:*",
    "@ihsp/features-core": "workspace:*",
    "@ihsp/i18n": "workspace:*",
    "@ihsp/telegram": "workspace:*",
    "@ihsp/ui": "workspace:*",
    "codemirror": "6.0.2",
    "h5p-standalone": "3.8.2",
    "pyodide": "314.0.8",
    "sql.js": "1.16.0"
  }
}
