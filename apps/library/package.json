{
  "name": "@ihsp/library",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "bun run copy:pdfjs && bun run build:sw && next build",
    "copy:pdfjs": "bun scripts/copy-pdfjs.mjs",
    "build:sw": "bun build ../../packages/features-core/src/pwa/sw/generic.ts --outfile public/sw.js --target browser --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 --preload ../../packages/test-utils/src/preload.ts"
  },
  "dependencies": {
    "@ihsp/api": "workspace:*",
    "@ihsp/auth": "workspace:*",
    "@ihsp/config": "workspace:*",
    "@ihsp/features-core": "workspace:*",
    "@ihsp/i18n": "workspace:*",
    "@ihsp/telegram": "workspace:*",
    "@ihsp/ui": "workspace:*"
  }
}
