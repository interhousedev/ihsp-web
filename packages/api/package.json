{
  "name": "@ihsp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types/*": "./src/types/*.ts",
    "./endpoints/*": "./src/endpoints/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ../test-utils/src/preload.ts",
    "gen:contract": "bun scripts/gen-contract-check.ts",
    "contract:check": "tsc -p tsconfig.contract.json --noEmit",
    "contract:report": "tsc -p tsconfig.contract-reverse.json --noEmit"
  },
  "dependencies": {
    "@ihsp/config": "workspace:*"
  },
  "devDependencies": {
    "@ihsp/test-utils": "workspace:*"
  }
}
