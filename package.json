{
  "name": "ihsp-web",
  "version": "0.0.0",
  "private": true,
  "description": "IHSP web: six statically exported Next.js apps and shared packages (Bun workspaces).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter './apps/*' build",
    "check": "oxlint . && oxfmt --check . && bun run --filter '*' typecheck && bun run e2e:typecheck",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "test": "bun test apps packages",
    "e2e": "bunx playwright test",
    "gen:api": "openapi-typescript packages/api/openapi.json -o packages/api/src/generated/openapi.d.ts --default-non-nullable false && openapi-typescript packages/api/openapi.json -o packages/api/src/generated/openapi-served.d.ts",
    "sync:openapi": "cp \"${IHSP_BACKEND_DIR:-../iht-backend}/openapi/openapi.json\" packages/api/openapi.json && bun run gen:api && bun run gen:contract",
    "gen:contract": "bun run --filter @ihsp/api gen:contract",
    "contract:check": "bun run --filter @ihsp/api contract:check",
    "e2e:typecheck": "tsc -p e2e --noEmit",
    "contract:report": "bun run --filter @ihsp/api contract:report"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/query-sync-storage-persister": "^5.95.2",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-persist-client": "^5.95.2",
    "@tanstack/react-table": "^9.3.1",
    "@tma.js/sdk-react": "^3.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "decode-named-character-reference": "1.3.0",
    "input-otp": "^1.4.2",
    "katex": "0.19.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-resolve-all": "2.0.1",
    "next": "16.2.12",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postcss": "8.5.30",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.4.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "micromark-util-types": "2.0.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.9.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25"
  }
}
